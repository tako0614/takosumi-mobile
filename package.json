{
  "name": "@takosjp/takosumi-mobile",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "bunx vite --config vite.config.ts",
    "dev:web": "bun run dev",
    "build": "bunx vite build --config vite.config.ts",
    "build:web": "bun run build",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "bun test tests",
    "mobile:check": "bun run doctor && bun run test && bun run check && bun run build",
    "mobile:doctor": "bun run doctor",
    "mobile:native-release-check": "bun run release:native-check",
    "mobile:release-evidence-check": "bun run release:evidence-check",
    "mobile:release-status": "bun run release:status",
    "doctor": "bun ../mobile-kit/scripts/check-tauri-mobile.mjs --product takosumi --scheme takosumi --product-name Takosumi --dev-port 1450",
    "release:native-check": "bun ../mobile-kit/scripts/check-tauri-mobile-release.mjs --product takosumi --scheme takosumi --product-name Takosumi --dev-port 1450",
    "release:evidence-check": "bun ../mobile-kit/scripts/check-mobile-release-evidence.mjs --product takosumi --product-name Takosumi --bundle-id com.takosumi",
    "release:check": "bun ../mobile-kit/scripts/check-mobile-full-release.mjs",
    "release:status": "bun ../mobile-kit/scripts/report-mobile-release-status.mjs --product takosumi --product-name Takosumi --bundle-id com.takosumi --require-secure-keystore",
    "release:repo-check": "bun ../mobile-kit/scripts/report-mobile-release-status.mjs --product takosumi --product-name Takosumi --bundle-id com.takosumi --require-secure-keystore --skip-toolchain-probe --fail-on-repo-blockers",
    "tauri:dev": "bunx tauri dev",
    "tauri:build": "bunx tauri build",
    "tauri:android:init": "bun ../mobile-kit/scripts/init-tauri-mobile-native.mjs --platform android --apple-environment development",
    "tauri:android-manifest:apply": "bun ../mobile-kit/scripts/apply-tauri-mobile-android-manifest.mjs --product takosumi",
    "tauri:android-manifest:verify": "bun ../mobile-kit/scripts/apply-tauri-mobile-android-manifest.mjs --product takosumi --dry-run --strict",
    "tauri:android:dev": "bunx tauri android dev --open --host",
    "tauri:android:build": "bunx tauri android build",
    "tauri:ios:init": "bun ../mobile-kit/scripts/init-tauri-mobile-native.mjs --platform ios --apple-environment development",
    "tauri:ios:dev": "bunx tauri ios dev",
    "tauri:ios:build": "bunx tauri ios build"
  },
  "dependencies": {
    "@takosjp/mobile-kit": "file:../mobile-kit",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-barcode-scanner": "^2.4.5",
    "@tauri-apps/plugin-biometric": "^2.3.2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-http": "^2.5.7",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-store": "^2.4.3",
    "@tauri-apps/plugin-stronghold": "^2.3.1",
    "solid-js": "^1.9.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/bun": "^1.2.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.14",
    "vite-plugin-solid": "^2.11.12"
  }
}
