{
  "description": "Which pages an app screen remembers as the place to reopen at (per instance, account and app). tests/url-policy.test.ts checks isRememberableAppScreenUrl in src/url-policy.ts against every case; AppScreenRules.kt and AppScreenPolicy.swift implement the same rule and list. A query parameter is a credential when its name, lowercased with everything but a-z and 0-9 removed, is listed and its value is not blank. The list is Takosumi's hasCredentialQueryParams (contract/interface-display.ts) plus OAuth and SAML callback values.",
  "credentialQueryNames": [
    "accesskey",
    "accesstoken",
    "apikey",
    "auth",
    "authorization",
    "bearertoken",
    "clientsecret",
    "cookie",
    "credential",
    "credentials",
    "credentialvalue",
    "jwt",
    "passwd",
    "password",
    "privatekey",
    "proxyauthorization",
    "refreshtoken",
    "secret",
    "session",
    "sessionid",
    "sessiontoken",
    "sig",
    "signature",
    "signingkey",
    "token",
    "xamzcredential",
    "xamzsecuritytoken",
    "xamzsignature",
    "xgoogcredential",
    "xgoogsignature",
    "xapikey",
    "code",
    "idtoken",
    "oauthtoken",
    "oauthverifier",
    "samlresponse",
    "ticket"
  ],
  "cases": [
    { "url": "https://app.example/inbox", "appOrigin": "https://app.example", "remember": true },
    { "url": "https://app.example/inbox?tab=2&q=hello+world", "appOrigin": "https://app.example", "remember": true },
    { "url": "https://app.example:443/inbox", "appOrigin": "https://app.example", "remember": true },
    { "url": "https://app.example/settings?token=", "appOrigin": "https://app.example", "remember": true },
    { "url": "https://app.example/auth/callback?code=abc&state=xyz", "appOrigin": "https://app.example", "remember": false },
    { "url": "https://app.example/x?access_token=abc", "appOrigin": "https://app.example", "remember": false },
    { "url": "https://app.example/x?Access-Token=abc", "appOrigin": "https://app.example", "remember": false },
    { "url": "https://app.example/x?id%5Ftoken=abc", "appOrigin": "https://app.example", "remember": false },
    { "url": "https://app.example/x?SAMLResponse=PHNhbWw%2B", "appOrigin": "https://app.example", "remember": false },
    { "url": "https://app.example/x?X-Amz-Signature=abc", "appOrigin": "https://app.example", "remember": false },
    { "url": "https://app.example/x?a=1&session=s1", "appOrigin": "https://app.example", "remember": false },
    { "url": "https://app.example/#/inbox", "appOrigin": "https://app.example", "remember": false },
    { "url": "https://app.example/x#access_token=abc", "appOrigin": "https://app.example", "remember": false },
    { "url": "https://app.example/x#", "appOrigin": "https://app.example", "remember": false },
    { "url": "https://user:pass@app.example/", "appOrigin": "https://app.example", "remember": false },
    { "url": "http://app.example/inbox", "appOrigin": "https://app.example", "remember": false },
    { "url": "https://other.example/inbox", "appOrigin": "https://app.example", "remember": false },
    { "url": "https://sub.app.example/inbox", "appOrigin": "https://app.example", "remember": false },
    { "url": "https://app.example:8443/inbox", "appOrigin": "https://app.example", "remember": false },
    { "url": "https://accounts.takosumi.example/oauth/authorize?client_id=x", "appOrigin": "https://app.example", "remember": false },
    { "url": "about:blank", "appOrigin": "https://app.example", "remember": false },
    { "url": "not a url", "appOrigin": "https://app.example", "remember": false }
  ]
}
