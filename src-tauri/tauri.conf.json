{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Takosumi",
  "version": "0.1.0",
  "identifier": "com.takosumi",
  "build": {
    "beforeDevCommand": "bun run dev:web",
    "beforeBuildCommand": "bun run build:web",
    "devUrl": "http://localhost:1450",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Takosumi",
        "width": 390,
        "height": 844,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": { "minSdkVersion": 28 }
  },
  "plugins": {
    "deep-link": {
      "mobile": [{ "scheme": ["takosumi"], "appLink": false }],
      "desktop": { "schemes": ["takosumi"] }
    }
  }
}
